## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio configuration directory
.vs/

# Visual Studio Code configuration directory
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# macOS directory files
.DS_Store

# JetBrains Rider configuration
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
.nuget/
packages/

# ASP.NET Core specific
appsettings.Development.json

# Environment variables
.env
