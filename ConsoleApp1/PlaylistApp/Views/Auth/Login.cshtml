@model PlaylistApp.Models.DTOs.LoginDto

<style>
    /* Spotify-inspired custom styles - High Contrast Fix */
    body {
        background-color: #121212 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .spotify-login-container {
        max-width: 734px;
        margin-top: 5rem;
    }

    .spotify-card {
        background-color: #000000;
        border-radius: 8px;
        border: none;
        padding: 4rem !important;
        color: #ffffff !important; /* Force card text to white */
    }

    .spotify-logo-text {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -1px;
        color: #ffffff !important; /* Force logo to white */
    }

    .spotify-title {
        font-size: 3rem;
        letter-spacing: -1px;
        font-weight: 700;
        color: #ffffff !important; /* Force title to white */
    }

    .spotify-label {
        font-weight: 700;
        font-size: 0.875rem;
        margin-bottom: 8px;
        color: #ffffff !important; /* Force labels to white */
    }

    .spotify-input {
        background-color: #121212;
        border: 1px solid #727272;
        color: #ffffff !important; /* Ensure typed text is white */
        border-radius: 4px;
        padding: 14px;
    }

        .spotify-input:focus {
            background-color: #121212;
            border-color: white;
            color: #ffffff !important;
            box-shadow: inset 0 0 0 1px white;
        }

        .spotify-input::placeholder {
            color: #a7a7a7 !important; /* Brighter, readable grey for placeholders */
            opacity: 1; /* Override Firefox's default placeholder opacity */
        }

    .spotify-btn {
        background-color: #1ed760;
        color: black;
        font-weight: 700;
        border-radius: 500px;
        border: none;
        padding: 14px 32px;
        font-size: 1rem;
        letter-spacing: 1px;
        transition: transform 33ms cubic-bezier(.3,0,0,1), background-color 33ms cubic-bezier(.3,0,0,1);
    }

        .spotify-btn:hover {
            background-color: #1fdf64;
            transform: scale(1.04);
            color: black;
        }

    .hint-text {
        color: #a7a7a7 !important; /* Brighter, readable grey for hint */
    }
</style>

<div class="container spotify-login-container">
    <div class="card shadow-lg spotify-card">

        <div class="text-center mb-5">
            <!-- Simulated Logo Area -->
            <div class="d-inline-flex align-items-center justify-content-center">
                <h1 class="spotify-logo-text mb-0">PlaylistApp</h1>
            </div>
        </div>

        <h2 class="text-center mb-5 spotify-title">Log in</h2>

        <hr class="border-secondary mb-5" />

        <!-- Centering the form inside the wide card -->
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                <form asp-action="Login" method="post">
                    <div class="mb-4">
                        <label class="form-label spotify-label">Email address or username</label>
                        <input asp-for="Username" class="form-control spotify-input" placeholder="Email address or username" />
                        <span asp-validation-for="Username" class="text-danger small mt-2 d-block fw-bold"></span>
                    </div>

                    <div class="mb-5">
                        <label class="form-label spotify-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control spotify-input" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small mt-2 d-block fw-bold"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn spotify-btn">Log In</button>
                    </div>
                </form>

                <div class="text-center mt-5 hint-text pb-4">
                    <small>Hint: admin / password123</small>
                </div>
            </div>
        </div>
    </div>
</div>